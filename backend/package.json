{
  "name": "ticket-booking-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ticket booking system API: seat holds with TTL, concurrency-safe booking, waitlists, QR tickets, realtime seat map.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "reset": "node src/db/migrate.js --fresh && node src/db/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18.17"
  }
}