# =====================================================================
# Ticket Booking System — example environment
# Copy to backend/.env and adjust. NEVER commit a real .env.
#   cp .env.example backend/.env
# =====================================================================

# --- Server ----------------------------------------------------------
NODE_ENV=development
PORT=4000

# SQLite file, relative to backend/. Use :memory: for a throwaway database.
DATABASE_FILE=data/ticket-booking.db

# --- Security --------------------------------------------------------
# Generate a real secret before deploying, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Seat holds ------------------------------------------------------
# How long a seat stays HELD before the backend releases it (10 minutes).
HOLD_TTL_SECONDS=600
# Maximum seats one customer may hold at a time.
MAX_SEATS_PER_HOLD=8

# --- Waitlist --------------------------------------------------------
# How long a waitlist customer has to accept an offered seat (5 minutes).
WAITLIST_OFFER_TTL_SECONDS=300

# How often the background sweeper expires holds and offers.
SWEEP_INTERVAL_MS=5000

# --- Email -----------------------------------------------------------
# file    = write rendered .html into backend/outbox/  (default, no credentials needed)
# console = print a summary to stdout
# smtp    = deliver for real using the SMTP settings below
MAIL_TRANSPORT=file
MAIL_FROM=Ticket Booking <no-reply@ticketbooking.local>
MAIL_OUTBOX_DIR=outbox

# Only needed when MAIL_TRANSPORT=smtp. Leave blank otherwise.
# Works with any free-tier provider (Mailtrap, Brevo, Resend, Gmail app password…).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Frontend --------------------------------------------------------
# Used by Vite at build time. Put this in frontend/.env if you change the port.
VITE_API_URL=http://localhost:4000
